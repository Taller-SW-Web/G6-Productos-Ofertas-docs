      "authorization": "Confirmación expresa de Marco recibida en el chat para estos dos permisos, con verificación y rollback.",
      "migrationSql": "begin;\nset local role po_promotions_owner;\nset local lock_timeout = '5s';\ndo $preflight$\nbegin\n  if to_regrole('promotions_dev_login') is null or\n     to_regprocedure('promotions.fn_begin_inbox(jsonb,text)') is null or\n     to_regprocedure('promotions.fn_valid_envelope(jsonb)') is null then\n    raise exception 'Unexpected Promotions runtime role or routines';\n  end if;\n  if has_function_privilege('promotions_dev_login','promotions.fn_begin_inbox(jsonb,text)','EXECUTE') or\n     has_function_privilege('promotions_dev_login','promotions.fn_valid_envelope(jsonb)','EXECUTE') then\n    raise exception 'Effective function grants changed since preflight';\n  end if;\nend\n$preflight$;\n\ngrant execute on function promotions.fn_begin_inbox(jsonb,text), promotions.fn_valid_envelope(jsonb)\nto promotions_dev_login;\n\ndo $verify$\nbegin\n  if not has_function_privilege('promotions_dev_login','promotions.fn_begin_inbox(jsonb,text)','EXECUTE') or\n     not has_function_privilege('promotions_dev_login','promotions.fn_valid_envelope(jsonb)','EXECUTE') then\n    raise exception 'Required runtime grants were not applied';\n  end if;\n  if exists (\n    select 1 from pg_proc p cross join lateral aclexplode(p.proacl) a\n    where p.oid in ('promotions.fn_begin_inbox(jsonb,text)'::regprocedure, 'promotions.fn_valid_envelope(jsonb)'::regprocedure)\n      and a.grantee = 0 and a.privilege_type = 'EXECUTE'\n  ) then\n    raise exception 'Unexpected public function grant';\n  end if;\nend\n$verify$;\nreset role;\ncommit;",
      "rollbackSql": "begin;\nset local role po_promotions_owner;\nrevoke execute on function promotions.fn_begin_inbox(jsonb,text), promotions.fn_valid_envelope(jsonb) from promotions_dev_login;\nreset role;\ncommit;",
