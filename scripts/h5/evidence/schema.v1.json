{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g6.example.invalid/h5-evidence/v1/schema.v1.json",
  "title": "G6 H5 evidence record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "h5_criterion", "owner", "scope", "source_repo", "source_sha", "docs_sha", "test_command", "environment", "evidence_level", "execution_result", "test_result", "implementation_state", "deployment_state", "homologation_state", "verification_state", "started_at", "finished_at", "artifact_uri", "artifact_sha256", "source", "config", "dataset", "dependencies", "blocking_dependency", "manual_review"],
  "properties": {
    "schema_version": {"const": "h5-evidence/v1"},
    "case_id": {"type": "string", "minLength": 1},
    "h5_criterion": {"enum": ["H5-01", "H5-02", "H5-03", "H5-04A", "H5-04B", "DOC-01", "SEC-DOC-01", "CLOSE-01"]},
    "owner": {"type": "string", "minLength": 1},
    "scope": {"enum": ["IN_SCOPE", "OUT_OF_SCOPE"]},
    "scope_justification": {"type": ["object", "null"], "required": ["reason", "record_uri", "approved_by"]},
    "source_repo": {"type": "string", "minLength": 1},
    "source_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "docs_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "test_command": {"type": "string"},
    "environment": {"type": "string"},
    "evidence_level": {"enum": ["L0", "L1", "L2", "L3", "STATIC", "ISOLATED", "LAB_AZURE", "STAGING_REAL", "INTERGROUP"]},
    "execution_result": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_RUN", "BLOCKED_APIM", "BLOCKED_SB", "BLOCKED_G7", "BLOCKED_G5", "BLOCKED_CONTRACT", "BLOCKED_PROVIDER", "BLOCKED_INFRA", "BLOCKED_BUDGET", "BLOCKED_AUTH", "BLOCKED_TOOL", "BLOCKED_GH_ADMIN", "BLOCKED_DATA"]},
    "test_result": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_RUN", "BLOCKED_APIM", "BLOCKED_SB", "BLOCKED_G7", "BLOCKED_G5", "BLOCKED_CONTRACT", "BLOCKED_PROVIDER", "BLOCKED_INFRA", "BLOCKED_BUDGET", "BLOCKED_AUTH", "BLOCKED_TOOL", "BLOCKED_GH_ADMIN", "BLOCKED_DATA"]},
    "implementation_state": {"enum": ["DONE_LOCAL", "READY_FOR_INTEGRATION", "BLOCKED_DEPENDENCY", "NEEDS_FIX"]},
    "deployment_state": {"enum": ["NOT_DEPLOYED", "DEPLOYED", "UNKNOWN"]},
    "homologation_state": {"enum": ["NOT_REQUIRED", "PENDING", "HOMOLOGATED", "UNKNOWN"]},
    "verification_state": {"enum": ["VERIFIED", "NOT_VERIFIED", "NOT_ACCESSIBLE", "EXPIRED"]},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "artifact_uri": {"type": ["string", "null"]},
    "artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "source": {"type": "object"}, "config": {"type": "object"}, "dataset": {"type": "object"},
    "dependencies": {"type": "array", "items": {"type": "object"}},
    "blocking_dependency": {"type": ["object", "null"]},
    "manual_review": {"enum": ["REVIEWED", "PENDING", "NOT_REQUIRED"]},
    "findings": {"type": "array", "items": {"type": "object"}},
    "run": {"type": ["object", "null"]},
    "metadata": {"type": "object"}
  }
}
